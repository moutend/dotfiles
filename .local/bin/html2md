#!/usr/bin/env bash

if [[ $# -ne 1 ]]; then
  echo "Usage: $(basename "$0") INPUT_HTML" >&2
  exit 1
fi

cat << 'EOF' > /tmp/force-fenced-codeblocks.lua
-- 言語(クラス)が無いCodeBlockに "text" を付与してフェンス化を誘導する
function CodeBlock(el)
  if el.classes == nil or #el.classes == 0 then
    el.classes = { "text" }
  end
  return el
end
EOF

cat << 'EOF' > /tmp/normalize-zenkaku-space.lua
-- U+3000 (UTF-8: E3 80 80) を ASCII space に置換
-- ついでに NBSP (U+00A0, UTF-8: C2 A0) も置換したい場合は有効化
local ZENKAKU = "\227\128\128"  -- U+3000
-- local NBSP = "\194\160"      -- U+00A0
function Str(el)
  el.text = el.text:gsub(ZENKAKU, " ")
  -- el.text = el.text:gsub(NBSP, " ")
  return el
end
EOF

input_html="$1"
output_md="${input_html%.*}.md"

pandoc \
  -f html -t gfm-raw_html --wrap=none \
  --lua-filter=/tmp/force-fenced-codeblocks.lua \
  --lua-filter=/tmp/normalize-zenkaku-space.lua \
  -o ${output_md} ${input_html}
