#!/usr/bin/env bash

# Extract text part from Jupitor Notebook (.ipynb)
if [ "$#" -ne 1 ]; then
  echo "Usage: $0 notebook.ipynb"
  exit 1
fi

FILE="$1"
output_file=$(echo "$1" | sed 's/.ipynb/.md/g')

jq -r '.cells[]
| select(.cell_type=="markdown" or .cell_type == "code")
| if .cell_type == "code" then "```code\n\(.source | join(""))\n```\n" else (.source | join("")) end' "$FILE" > $output_file
