#!/usr/bin/env bash

set -xeuo pipefail

# Hooks for login shell
cat << 'EOF' > $HOME/.python-bashrc
PS1='\$ '
echo -e '\a'
EOF

docker run -it --rm --name python-development-container \
  -p 8765:8765 \
  -v .:/app \
  -v "$HOME/.python-bashrc:/root/.bashrc:ro" \
  --entrypoint /bin/bash \
  python-develop
